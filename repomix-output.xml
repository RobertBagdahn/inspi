        # norm_person
        gender_ref = "M"
        ageInYear_ref = 15
        activityFactor_ref = 1.5
        engery_ref = self.energyByGenderAndAge(
            gender_ref,
            ageInYear_ref,
            activityFactor_ref,
        )

        engery_current = self.energyByGenderAndAge(gender, ageInYear, activityFactor)

        return round(engery_current / engery_ref, 2)
