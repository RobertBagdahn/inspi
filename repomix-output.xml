def get_hungriness_obj(recipe):
    """
    Get hungriness object for a recipe.

    Args:
        recipe: Recipe object to evaluate

    Returns:
        Dictionary with hungriness information
    """
    # Default values
    hungriness = {"score": 0, "description": "", "level": "medium"}

