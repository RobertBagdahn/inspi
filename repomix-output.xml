    <p class="my-4">Summe: {{ nutri_item.sum|floatformat:1 }} {{ nutri_item.unit }}</p>
    <div class="my-4">
        <span class="block w-full mb-2 text-sm font-medium text-gray-700 dark:text-gray-300">Top 3 Zutaten:</span>
        <ul class="list-disc pl-5 text-sm text-gray-600 dark:text-gray-400">
            {% if nutri_item.processed_top_3|length > 0 %}
                {% for item in nutri_item.processed_top_3 %}
                    <li>{{ item.ingredient_name }}: {{ item.value|floatformat:1 }} {{ nutri_item.unit }}</li>
                {% endfor %}
            {% else %}
                <li>Keine Daten verfügbar</li>
            {% endif %}
        </ul>
