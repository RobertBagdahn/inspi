                                Intro
                            {% elif forloop.counter0 == 1 %}
                                Basis
                            {% elif forloop.counter0 == 2 %}
                                Physikalisch
                            {% elif forloop.counter0 == 3 %}
                                Allergene
                            {% elif forloop.counter0 == 4 %}
                                Bewertungen
                            {% elif forloop.counter0 == 5 %}
                                Rezept
                            {% elif forloop.counter0 == 6 %}
                                Nährwerte
                            {% elif forloop.counter0 == 7 %}
                                Verwaltung
