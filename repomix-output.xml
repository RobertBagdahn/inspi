            {% if nutri_item.hints|length > 0 %}
                {% for hint in nutri_item.hints %}
                    <li class=" {% if hint.hint_level == 'warn' %}  font-bold text-yellow-400  {% elif hint.hint_level == 'error' %}  font-bold text-red-500  {% endif %}">
                        {{ hint.hint }}
                    </li>
