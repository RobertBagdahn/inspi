                                <td class="px-4 py-2">
                                    <div class="text-xs text-gray-500 dark:text-gray-400">{{ ingredient.nutri_points }} Punkte</div>
                                    <div class="text-xs text-gray-500 dark:text-gray-400">{{ ingredient.weight_g }}g</div>
