                        hx-on="htmx:afterRequest: window.location.href = '{{ after_post_url }}'"
                        type="button"
                        class="text-white bg-red-600 hover:bg-red-700 focus:ring-4 focus:outline-none focus:ring-red-200 font-semibold rounded-lg text-sm inline-flex items-center px-5 py-2.5 text-center mr-3 shadow-sm hover:shadow transition-all duration-200">
                    Ja, sicher
                </button>
                <button data-modal-hide="{{ id }}"
                        type="button"
                        class="text-gray-600 bg-white hover:bg-gray-50 focus:ring-4 focus:outline-none focus:ring-gray-100 rounded-lg border border-gray-200 text-sm font-semibold px-5 py-2.5 hover:text-gray-800 transition-all duration-200">
                    Nein, abbrechen
                </button>
            </div>
        </div>
    </div>
</div>
