<file path="group/templates/membership/manage_permissions.html">
{% extends "_base.html" %}
{% block content %}
    <h2>Manage Permissions for {{ group.name }}</h2>
    <div class="container mx-auto px-4">
        <div class="bg-white shadow-md rounded my-6">
            <table class="min-w-full bg-white">
                <thead>
                    <tr>
                        <th class="py-2 px-4 bg-gray-200 font-bold uppercase text-sm text-gray-600">Parent Group</th>
                        <th class="py-2 px-4 bg-gray-200 font-bold uppercase text-sm text-gray-600">Group</th>
                        <th class="py-2 px-4 bg-gray-200 font-bold uppercase text-sm text-gray-600">Read Access</th>
                        <th class="py-2 px-4 bg-gray-200 font-bold uppercase text-sm text-gray-600">Full Access</th>
                        <th class="py-2 px-4 bg-gray-200 font-bold uppercase text-sm text-gray-600">Created By</th>
                        <th class="py-2 px-4 bg-gray-200 font-bold uppercase text-sm text-gray-600">Created At</th>
                    </tr>
                </thead>
                <tbody>
                    {% for permission in permissions %}
                        <tr class="hover:bg-gray-100">
                            <td class="py-2 px-4 border-b border-gray-200">{{ permission.parent_group.name }}</td>
                            <td class="py-2 px-4 border-b border-gray-200">{{ permission.group.name }}</td>
                            <td class="py-2 px-4 border-b border-gray-200">{{ permission.read_access|yesno:"Yes,No" }}</td>
                            <td class="py-2 px-4 border-b border-gray-200">{{ permission.full_access|yesno:"Yes,No" }}</td>
                            <td class="py-2 px-4 border-b border-gray-200">{{ permission.created_by.username }}</td>
                            <td class="py-2 px-4 border-b border-gray-200">{{ permission.created_at }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock content %}
</file>

<file path="group/templates/membership/membership_detail.html">
{% extends 'group/details/_group_detail_base.html' %}
{% load component_tags %}
{% block detailcontent %}
    <section class="bg-gray-50 py-8 antialiased dark:bg-gray-900 md:py-8">
        <div class="mx-auto max-w-screen-lg px-4 2xl:px-0">
            <h2 class="text-2xl font-bold mb-1">Mitgliedschaft</h2>
            <p class="text-gray-500 dark:text-gray-400 mb-4">
                Hier sind alle Informationen zu deiner Mitgliedschaft in der Gruppe aufgelistet
            </p>
            {% component 'simple-list' items=items %} {% endcomponent %}
            <div class="mt-4">
                <div class="flex space-x-4">
                    {% if not membership.is_canceled %}
                        {% component 'link-button' color='red' text='Mitgliedschaft beenden' icon='leave' url="{% url 'remove-membership' membership.id %}" %}
                    {% endcomponent %}
                {% endif %}
                {% if is_member and not membership.is_canceled %}
                    {% component 'link-button' color='blue' text='bearbeiten als Mitglied' icon='edit' url="{% url 'edit-membership-member' membership.id %}" %}
                {% endcomponent %}
            {% endif %}
            {% if is_admin and not membership.is_canceled %}
                {% component 'link-button' color='blue' text='bearbeiten als Admin' icon='edit' url="{% url 'edit-membership-admin' membership.id %}" %}
            {% endcomponent %}
        {% endif %}
    </div>
</div>
</div>
</section>
{% endblock %}
</file>

