<file path="activity/activity/templates/activity/create/start.html">
{% extends "_base.html" %}
{% load main_extras %}
{% load crispy_forms_tags %}
{% load static %}
{% block head %}
    {{ wizard.form.media }}
{% endblock head %}
{% block header %}
{% endblock header %}
{% block content %}
    <section class="bg-white dark:bg-gray-900">
        <div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-6">
            <div class="mx-auto max-w-screen-md text-center mb-8 lg:mb-12">
                <h2 class="mb-4 text-4xl tracking-tight font-extrabold text-gray-900 dark:text-white">
                    Füge deine Gruppenstunden Idee hinzu
                </h2>
                <p class="mb-5 font-light text-gray-500 sm:text-xl dark:text-gray-400">Werde Teil von Inspi's Ideen.</p>
            </div>
            <div class="space-y-8 lg:grid lg:grid-cols-2 sm:gap-6 xl:gap-10 lg:space-y-0">
                <!-- Pricing Card -->
                <div class="flex flex-col p-6 mx-auto max-w-lg text-center text-gray-900 bg-white rounded-lg border border-gray-100 shadow dark:border-gray-600 xl:p-8 dark:bg-gray-800 dark:text-white">
                    <h3 class="mb-4 text-2xl font-semibold">Kurze Idee</h3>
                    <p class="font-light text-gray-500 sm:text-lg dark:text-gray-400">
                        Starte mit einem kurzen Text und füge später mehr hinzu oder lasse den Rest von Inspi einfügen.
                    </p>
                    <div class="flex justify-center items-baseline my-8"></div>
                    <!-- List -->
                    <ul role="list" class="mb-8 space-y-4 text-left">
                        <li class="flex items-center space-x-3">
                            <!-- Icon -->
                            <svg class="flex-shrink-0 w-5 h-5 text-green-500 dark:text-green-400"
                                 fill="currentColor"
                                 viewBox="0 0 20 20"
                                 xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd">
                                </path>
                            </svg>
                            <span>Kurze Zusammenfassung der Heimabend-Idee</span>
                        </li>
                    </ul>
                    {% if user.is_authenticated %}
                        <a href="{% url 'activity-create-short-loggedin' %}"
                           class="text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:ring-blue-200 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:text-white dark:focus:ring-blue-900">Los gehts mit deinem User</a>
                    {% else %}
                        <a href="{% url 'activity-create-short-loggedout' %}"
                           class="text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:ring-blue-200 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:text-white dark:focus:ring-blue-900">Los gehts ohne User</a>
                        <a>Wenn du bereits einen Account hast, logge dich ein und erstelle die Idee mit deinem Account.</a>
                    {% endif %}
                </div>
                <div class="flex flex-col p-6 mx-auto max-w-lg text-center text-gray-900 bg-white rounded-lg border border-gray-100 shadow dark:border-gray-600 xl:p-8 dark:bg-gray-800 dark:text-white">
                    <h3 class="mb-4 text-2xl font-semibold">Komplette Idee</h3>
                    <p class="font-light text-gray-500 sm:text-lg dark:text-gray-400">
                        Erstelle deine Idee komplett selbst und füge alle wichtigen Informationen hinzu.
                    </p>
                    <div class="flex justify-center items-baseline my-8"></div>
                    <!-- List -->
                    <ul role="list" class="mb-8 space-y-4 text-left">
                        <li class="flex items-center space-x-3">
                            <!-- Icon -->
                            <svg class="flex-shrink-0 w-5 h-5 text-green-500 dark:text-green-400"
                                 fill="currentColor"
                                 viewBox="0 0 20 20"
                                 xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd">
                                </path>
                            </svg>
                            <span>Titel, Zusammenfassung, Text</span>
                        </li>
                        <li class="flex items-center space-x-3">
                            <!-- Icon -->
                            <svg class="flex-shrink-0 w-5 h-5 text-green-500 dark:text-green-400"
                                 fill="currentColor"
                                 viewBox="0 0 20 20"
                                 xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd">
                                </path>
                            </svg>
                            <span>Kriterien</span>
                        </li>
                        <li class="flex items-center space-x-3">
                            <!-- Icon -->
                            <svg class="flex-shrink-0 w-5 h-5 text-green-500 dark:text-green-400"
                                 fill="currentColor"
                                 viewBox="0 0 20 20"
                                 xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd">
                                </path>
                            </svg>
                            <span>Tags</span>
                        </li>
                        <li class="flex items-center space-x-3">
                            <!-- Icon -->
                            <svg class="flex-shrink-0 w-5 h-5 text-green-500 dark:text-green-400"
                                 fill="currentColor"
                                 viewBox="0 0 20 20"
                                 xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd">
                                </path>
                            </svg>
                            <span>Material</span>
                        </li>
                    </ul>
                    {% if user.is_authenticated %}
                        <a href="{% url 'activity-create-full-loggedin' %}"
                           class="text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:ring-blue-200 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:text-white dark:focus:ring-blue-900">Los gehts mit deinem User</a>
                    {% else %}
                        <a href="{% url 'activity-create-full-loggedout' %}"
                           class="text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:ring-blue-200 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:text-white dark:focus:ring-blue-900">Los gehts ohne User</a>
                        <a>Wenn du bereits einen Account hast, logge dich ein und erstelle die Idee mit deinem Account.</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
{% endblock content %}
</file>

<file path="activity/activity/templates/activity/dashboard/table-row.html">
<tr class="border-b dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700">
    <th scope="row"
        class="px-4 py-2 font-medium text-gray-900 whitespace-nowrap dark:text-white">{{ activity.title }}</th>
    <td class="px-4 py-2 whitespace-nowrap">
        <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300">{{ activity.get_status_display }}</span>
