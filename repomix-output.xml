    factor = forms.FloatField(
        widget=forms.NumberInput(attrs={"class": "tailwind-input"}),
    )

    class Meta:
        model = MealItem
        fields = [
            "meal",
            "recipe",
            "factor",
        ]


class MealItemFormUpdate(forms.ModelForm):
    class Meta:
        model = MealItem
