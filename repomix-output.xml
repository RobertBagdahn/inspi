    STAMM = 'Stamm', _('Stamm')
    GRUPPE = 'Gruppe', _('Gruppe')

    @staticmethod
    def get_level_choice_plural(choice: str) -> str:
        plural_dict = {
            'Verband': 'Verbände',
            'Bund': 'Bünde',
            'Ring': 'Ringe',
            'Stamm': 'Stämme',
            'Gruppe': 'Gruppe',
            'Scout': 'Pfadfinder*innen'
