    <div class="border-b border-gray-200 py-4 dark:border-gray-700 sm:flex sm:items-center sm:justify-between">
        <dt class="font-semibold text-gray-900 dark:text-white">Verwaltet von</dt>
        <dd class="sm:text-end">
            {% if ingredient.managed_by.all %}
                <div>
                    {% for manager in ingredient.managed_by.all %}
                        <a href="{% url 'user-detail-overview' manager.username %}"
                           class="text-blue-500 hover:underline">{{ manager }}</a>
                        {% if not forloop.last %},{% endif %}
                    {% endfor %}
                </div>
            {% else %}
                -
            {% endif %}
        </dd>
    </div>
    <div class="border-gray-200 py-4 dark:border-gray-700 sm:flex sm:items-center sm:justify-between">
        <dt class="font-semibold text-gray-900 dark:text-white">Verwaltet von Gruppe</dt>
        <dd class="sm:text-end">
            {% if ingredient.managed_by_group and ingredient.managed_by_group.slug %}
                <a href="{% url 'group-detail-overview' ingredient.managed_by_group.slug %}"
                   class="text-blue-500 hover:underline">{{ ingredient.managed_by_group.name }}</a>
            {% else %}
                -
            {% endif %}
        </dd>
    </div>
</div>
</file>

